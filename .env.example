# PostgreSQL connection, consumed only by the backend. Preserve provider SSL options.
DATABASE_URL=postgresql://username:password@database-host:5432/database?sslmode=require
# Docker Compose supplies BACKEND_API_KEY from the root .env.
# Set it here too if running the API outside Compose.
BACKEND_API_KEY=replace-with-a-long-random-value

# Fixed session lifetime; users sign in again after expiry (1–168 hours).
AUTH_SESSION_HOURS=12
